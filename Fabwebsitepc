<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FAB WEBSITE</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
  :root{
    --bg:#0a0a0c;
    --fg:#5f7690;
    --fg-strong:#a9bdd4;
    --line:#2b2e33;
    --node-fill:#0a0a0c;
    --node-stroke:#33507a;
  }
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){
      --bg:#0a0a0c;
      --fg:#5f7690;
      --fg-strong:#a9bdd4;
      --line:#2b2e33;
      --node-fill:#0a0a0c;
      --node-stroke:#33507a;
    }
  }
  :root[data-theme="light"]{
    --bg:#0a0a0c;
    --fg:#5f7690;
    --fg-strong:#a9bdd4;
    --line:#2b2e33;
    --node-fill:#0a0a0c;
    --node-stroke:#33507a;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;
    height:100%;
    background:var(--bg);
    overflow:hidden;
  }
  body{
    font-family: "Trebuchet MS", "Segoe UI", Helvetica, Arial, sans-serif;
  }
  #hint{
    position:fixed;
    top:14px;
    left:18px;
    color:var(--fg);
    font-size:13px;
    letter-spacing:.03em;
    opacity:.7;
    z-index:5;
    pointer-events:none;
  }
  #tree{
    width:100vw;
    height:100vh;
    cursor:grab;
  }
  #tree:active{ cursor:grabbing; }

  .link{
    fill:none;
    stroke:var(--line);
    stroke-width:1px;
  }

  .node circle{
    fill:var(--node-fill);
    stroke:var(--node-stroke);
    stroke-width:1.6px;
    cursor:pointer;
    transition:stroke .15s ease, r .15s ease;
  }
  .node circle:hover{
    stroke:var(--fg-strong);
    r:6.5;
  }
  .node--leaf circle{
    stroke:var(--node-stroke);
  }
  .node--leaf.node--link circle{
    stroke:#2f8f5c;
  }

  .node text{
    fill:var(--fg);
    font-size:13px;
    cursor:pointer;
    user-select:none;
    transition:fill .15s ease;
  }
  .node--root text{
    fill:var(--fg-strong);
    font-weight:700;
    font-size:17px;
    letter-spacing:.04em;
  }
  .node--link text{
    fill:#3ea86f;
  }
  .node text:hover{
    fill:var(--fg-strong);
  }
  .node--link text:hover{
    fill:#4ac47d;
  }

  #gate{
    position:fixed;
    inset:0;
    background:var(--bg);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    gap:18px;
    z-index:20;
  }
  #gate.hidden{
    display:none;
  }
  #gate-label{
    color:var(--fg-strong);
    font-size:15px;
    letter-spacing:.08em;
  }
  #gate-input{
    background:transparent;
    border:1.6px solid var(--node-stroke);
    color:var(--fg-strong);
    font-size:20px;
    letter-spacing:.3em;
    text-align:center;
    width:140px;
    padding:10px 12px;
    border-radius:6px;
    outline:none;
  }
  #gate-input:focus{
    border-color:var(--fg-strong);
  }
  #gate-error{
    color:#c14b4b;
    font-size:13px;
    min-height:16px;
    opacity:0;
    transition:opacity .15s ease;
  }
  #gate-error.show{
    opacity:1;
  }
  #app{
    display:none;
  }
  #app.visible{
    display:block;
  }
</style>
</head>
<body>
<div id="gate">
  <div id="gate-label">CODE D'ACCÈS</div>
  <input id="gate-input" type="password" inputmode="numeric" maxlength="6" autofocus>
  <div id="gate-error">Code incorrect</div>
</div>

<div id="app">
<div id="hint">clique sur un rond pour ouvrir / fermer &middot; molette pour zoomer &middot; glisser pour déplacer</div>
<svg id="tree"></svg>
</div>

<script>
const ACCESS_CODE = "122";
const gate = document.getElementById("gate");
const gateInput = document.getElementById("gate-input");
const gateError = document.getElementById("gate-error");
const app = document.getElementById("app");

function tryUnlock() {
  if (gateInput.value.trim() === ACCESS_CODE) {
    gate.classList.add("hidden");
    app.classList.add("visible");
    initTree();
  } else {
    gateError.classList.add("show");
    gateInput.value = "";
    gateInput.focus();
  }
}

gateInput.addEventListener("keydown", (e) => {
  gateError.classList.remove("show");
  if (e.key === "Enter") tryUnlock();
});

window.addEventListener("DOMContentLoaded", () => gateInput.focus());
</script>

<script>
function initTree() {
const treeData = {
  name: "FAB WEBSITE",
  children: [
    {
      name: "FILM",
      children: [
        { name: "neocine.xyz", url: "https://neocine.xyz/" },
        { name: "skystream.fun", url: "https://skystream.fun/" },
        { name: "cineregal.one", url: "https://cineregal.one/" }
      ]
    },
    {
      name: "FOOT",
      children: [
        { name: "kooratv.club", url: "https://kooratv.club/" },
        { name: "soccerbox.me", url: "https://soccerbox.me/" }
      ]
    }
  ]
};

const svg = d3.select("#tree");
const gZoom = svg.append("g").attr("class", "zoom-layer");

let width = window.innerWidth;
let height = window.innerHeight;
svg.attr("viewBox", [0, 0, width, height]);

const dx = 26;
const dy = 220;

const tree = d3.tree().nodeSize([dx, dy]);
const diagonal = d3.linkHorizontal().x(d => d.y).y(d => d.x);

const root = d3.hierarchy(treeData);
root.x0 = 0;
root.y0 = 0;

root.descendants().forEach((d, i) => {
  d.id = i;
  d._children = d.children;
  if (d.depth >= 1) {
    d.children = null;
  }
});

const gLink = gZoom.append("g")
  .attr("fill", "none")
  .attr("stroke", "var(--line)")
  .attr("stroke-width", 1);

const gNode = gZoom.append("g")
  .attr("cursor", "pointer");

function update(source) {
  const duration = 260;
  const nodes = root.descendants().reverse();
  const links = root.links();

  tree(root);

  const node = gNode.selectAll("g.node")
    .data(nodes, d => d.id);

  const nodeEnter = node.enter().append("g")
    .attr("class", d => "node" +
      (d.depth === 0 ? " node--root" : "") +
      (!d._children && !d.children ? " node--leaf" : "") +
      (d.data.url ? " node--link" : ""))
    .attr("transform", d => `translate(${source.y0},${source.x0})`)
    .attr("fill-opacity", 0)
    .attr("stroke-opacity", 0)
    .on("click", (event, d) => {
      if (d.data.url) {
        window.open(d.data.url, "_blank", "noopener,noreferrer");
        return;
      }
      if (d.children) {
        d._children = d.children;
        d.children = null;
      } else {
        d.children = d._children;
        d._children = null;
      }
      update(d);
    });

  nodeEnter.append("circle")
    .attr("r", 5);

  nodeEnter.append("text")
    .attr("dy", "0.32em")
    .attr("x", d => (d.children || d._children) ? -12 : 12)
    .attr("text-anchor", d => (d.children || d._children) ? "end" : "start")
    .text(d => d.data.name)
    .clone(true).lower()
    .attr("stroke", "var(--bg)")
    .attr("stroke-width", 3);

  const nodeUpdate = node.merge(nodeEnter).transition().duration(duration)
    .attr("transform", d => `translate(${d.y},${d.x})`)
    .attr("fill-opacity", 1)
    .attr("stroke-opacity", 1);

  node.exit().transition().duration(duration).remove()
    .attr("transform", d => `translate(${source.y},${source.x})`)
    .attr("fill-opacity", 0)
    .attr("stroke-opacity", 0);

  const link = gLink.selectAll("path.link")
    .data(links, d => d.target.id);

  const linkEnter = link.enter().append("path")
    .attr("class", "link")
    .attr("d", d => {
      const o = { x: source.x0, y: source.y0 };
      return diagonal({ source: o, target: o });
    });

  link.merge(linkEnter).transition().duration(duration)
    .attr("d", diagonal);

  link.exit().transition().duration(duration).remove()
    .attr("d", d => {
      const o = { x: source.x, y: source.y };
      return diagonal({ source: o, target: o });
    });

  root.eachBefore(d => {
    d.x0 = d.x;
    d.y0 = d.y;
  });
}

update(root);

function recenter() {
  width = window.innerWidth;
  height = window.innerHeight;
  svg.attr("viewBox", [0, 0, width, height]);
  gZoom.attr("transform", `translate(60, ${height / 2})`);
}
recenter();
window.addEventListener("resize", recenter);

const zoomBehavior = d3.zoom()
  .scaleExtent([0.4, 2.5])
  .on("zoom", (event) => {
    gZoom.attr("transform", event.transform.translate(60 / event.transform.k, height / (2 * event.transform.k)));
  });
svg.call(zoomBehavior).on("dblclick.zoom", null);
}
</script>
</body>
</html>
